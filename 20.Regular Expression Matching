class Solution {
    public boolean isMatch(String s, String p) {

        int m = s.length();
        int n = p.length();

        // dp[i][j] = whether s[i:] matches p[j:]
        boolean[][] dp = new boolean[m + 1][n + 1];

        // Empty string matches empty pattern
        dp[m][n] = true;

        // Fill from bottom-right
        for (int i = m; i >= 0; i--) {
            for (int j = n - 1; j >= 0; j--) {

                // Check if current characters match
                boolean firstMatch = (i < m &&
                        (s.charAt(i) == p.charAt(j) ||
                         p.charAt(j) == '.'));

                // If next character is '*'
                if (j + 1 < n && p.charAt(j + 1) == '*') {

                    // Option 1: '*' matches zero characters
                    boolean zero = dp[i][j + 2];

                    // Option 2: '*' matches one or more characters
                    boolean oneOrMore =
                            firstMatch && dp[i + 1][j];

                    dp[i][j] = zero || oneOrMore;

                } else {

                    // Normal character or '.'
                    dp[i][j] =
                            firstMatch && dp[i + 1][j + 1];
                }
            }
        }

        return dp[0][0];
    }
}
