class Solution {
    public boolean isPalindrome(int x) {

        // Negative numbers are not palindrome
        if (x < 0) {
            return false;
        }

        // Numbers ending with 0 (except 0 itself) are not palindrome
        if (x % 10 == 0 && x != 0) {
            return false;
        }

        int reverse = 0;

        while (x > reverse) {
            int digit = x % 10;
            reverse = reverse * 10 + digit;
            x = x / 10;
        }

        return x == reverse || x == reverse / 10;
    }
}
